# ==========================================
# Benchbook Environment Configuration Template
# ==========================================

# ------------------------------------------
# Backend Settings (FastAPI)
# ------------------------------------------
# Database Connection URL:
# - Local SQLite default: sqlite:///./benchbook.db
# - Hosted PostgreSQL (e.g. Neon Free / Render / Railway):
#   postgresql://user:password@ep-cool-benchbook.neon.tech/neondb?sslmode=require
BENCHBOOK_DATABASE_URL=sqlite:///./benchbook.db
# DATABASE_URL is also accepted as an alias by cloud hosts:
# DATABASE_URL=postgresql://user:password@ep-cool-benchbook.neon.tech/neondb?sslmode=require

# Application Environment: local, staging, production
BENCHBOOK_ENVIRONMENT=local

# Milestone: M1, M2
BENCHBOOK_MILESTONE=M2

# Assistant Operating Mode:
# Options: deterministic (default offline rules), timeout, busy, unavailable, invalid_output
BENCHBOOK_ASSISTANT_MODE=deterministic

# CORS Allowed Origins (comma-separated or JSON list):
BENCHBOOK_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000

# Repair Shop Context Metadata:
BENCHBOOK_SHOP_NAME=Kovai Tech Bench
BENCHBOOK_SHOP_LOCATION=Gandhipuram, Coimbatore, Tamil Nadu
BENCHBOOK_SHOP_PHONE=+91 98400 11223

# ------------------------------------------
# Frontend Settings (React / Vite)
# ------------------------------------------
# Backend API base URL for client-side fetches:
# Local development default: http://localhost:8001
# Hosted production example: https://benchbook-api.onrender.com
VITE_API_BASE_URL=http://localhost:8001
